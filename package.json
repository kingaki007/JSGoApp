{
  "name": "code-editor",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @code-editor/web dev",
    "dev:desktop": "pnpm --filter @code-editor/desktop dev",
    "dev:api": "pnpm --filter @code-editor/api dev",
    "dev:runner": "pnpm --filter @code-editor/runtime-node build && pnpm --filter @code-editor/runner dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r typecheck",
    "test": "pnpm --filter @code-editor/runtime-node build && vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:next": "tsx scripts/version.ts",
    "version:check": "tsx scripts/version.ts --check",
    "check": "pnpm version:check && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "latest",
    "vitest": "latest"
  }
}
