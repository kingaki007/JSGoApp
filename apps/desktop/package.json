{
  "name": "@code-editor/desktop",
  "version": "0.6.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx ../../scripts/build-desktop.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @code-editor/runtime-node build && pnpm build && electron . --dev",
    "start": "electron .",
    "smoke": "pnpm --filter @code-editor/runtime-node build && pnpm build && electron . --smoke-test"
  },
  "dependencies": {
    "@code-editor/core": "workspace:*",
    "@code-editor/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.0.0"
  }
}
